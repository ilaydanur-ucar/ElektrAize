# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Firebase Web API Key (for email verification and client-side auth)
FIREBASE_API_KEY=your_firebase_api_key_here

# Alternative naming (used in email_routes.py)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Path to Firebase Admin SDK credentials JSON file
# Place firebase_config.json in the project root directory
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_CONFIG_PATH=firebase_config.json

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# SQLITE DATABASE (Optional - for local user storage)
# ============================================
# Local SQLite database URL (defaults to sqlite:///./elektraize.db if not set)
DATABASE_URL=sqlite:///./elektraize.db

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================
# Redis host and port
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# SERVER CONFIGURATION
# ============================================
# API server host and port (optional, used in main.py)
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# ENVIRONMENT
# ============================================
# Set to 'production' or 'development'
ENVIRONMENT=development
